# Ollama runs natively on macOS so it can use Apple Metal. Start it with:
#   ollama serve
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Leave blank to have a random secret generated and kept in the uploads volume.
# If you set one, use at least 32 random characters; placeholders are ignored.
JWT_SECRET=
REGISTRATION_ENABLED=true
MAX_UPLOAD_MB=50
UPLOAD_DIR=/data/uploads
DATABASE_URL=postgresql://rag:rag-local-password@postgres:5432/localrag
APP_PORT=3000

# Retrieval tuning
CHUNK_TOKENS=420
CHUNK_OVERLAP=60
RETRIEVAL_MIN_SIMILARITY=0.28
# fused candidates sent to the reranker, and passages kept for the prompt
RETRIEVAL_CANDIDATES=12
RETRIEVAL_TOP_K=5
# false skips the LLM rerank pass: faster, but grounding can then never read "strong"
RERANK_ENABLED=true
# false stops distilling questions into library memory
MEMORY_ENABLED=true
